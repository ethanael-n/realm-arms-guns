			"animations": [
				{
					"var.sway": "0.6",
					"var.shift": "0.6",
					"var.lean": "0.6",
					"var.lag_share": "0.5",
					"var.flinch": "0.5",
					"varb.pfc": "frame_counter == var.pre_frame_counter",
					"var.id": "random(id)*pi*4",
					"var.Bt": "var.id +age/2",
					"var.Ut": "var.id +age/9",
					"var.yrot_offset": "if( varb.pfc, var.yrot_offset, var.yrot_offset +if( between( var.pre_roty-rot_y, -pi*2, -pi*2+0.2 ), -pi*2, between( var.pre_roty-rot_y, pi*2-0.2, pi*2 ), pi*2, 0 ) )",
					"var.roty": "rot_y +var.yrot_offset",
					"var.rotation": "if( varb.pfc, var.rotation, !equals(var.roty,var.pre_Oroty,1), var.roty, var.roty*min(1,frame_time*2) +var.rotation*max(0,1-frame_time*2) )",
					"var.lag": "clamp( var.rotation-var.roty, -0.6, 0.6 )",
					"var.speed": "if( varb.pfc, var.speed, age<9, 0, limb_speed*min(1,frame_time*4) +var.speed*max(0,1-frame_time*4) )",
					"var.moveB": "(0.3+0.7*min(1,limb_speed))",
					"var.hurt": "(hurt_time/10)*(hurt_time/10)*max(0, (1-hurt_time/10)*8 )*0.2"
				},
				{
					"balloons_sway.rx": "( -sin(var.Bt/6)/8*var.moveB )*var.sway +torad( (-9-20*sin(limb_swing/4))*var.hurt )*var.flinch",
					"balloons_sway.rz": "( sin(var.Bt/5)/17*var.moveB )*var.sway +clamp( var.lag/2, -1, 1 )/3*min(1,var.speed*4)*var.lean +torad( 30*cos(limb_swing/6)*var.hurt )*var.flinch",
					"balloons_sway.ry": "var.lag*var.lag_share",
					"balloons_sway.tx": "( -cos(var.Bt/5)*var.moveB )*var.shift",
					"balloons_sway.tz": "( -cos(var.Bt/6)*var.moveB )*var.shift",
					"balloons_sway.ty": "( -cos(var.Ut/2)/2 )*var.shift"
				},
				{
					"var.aim_speed": "6",
					"var.yaw_sign": "-1",
					"var.pitch_sign": "-1",
					"var.crossbow_up": "15",
					"var.crossbow_down": "75",
					"var.rudder_gain": "1.2",
					"var.rudder_dir": "1",
					"var.ease": "min(1, frame_time*var.aim_speed)",
					"var.cy_t": "if(round(cannon_signal.rz) == 1, cannon_signal.ry, 0)",
					"var.cp_t": "if(round(cannon_signal.rz) == 1, cannon_signal.rx, 0)",
					"var.xp_t": "if(round(crossbow_signal.rz) == 1, clamp(crossbow_signal.rx, torad(-var.crossbow_down), torad(var.crossbow_up)), 0)",
					"var.cy_d": "var.cy_t -var.cy",
					"var.cy_dw": "var.cy_d -2*pi*round(var.cy_d/(2*pi))",
					"var.cy_raw": "if(varb.pfc, var.cy, var.cy +var.cy_dw*var.ease)",
					"var.cy": "var.cy_raw -2*pi*round(var.cy_raw/(2*pi))",
					"var.cp": "if(varb.pfc, var.cp, var.cp +(var.cp_t -var.cp)*var.ease)",
					"var.xp": "if(varb.pfc, var.xp, var.xp +(var.xp_t -var.xp)*var.ease)",
					"var.drop": "round(balloon_signal3.rx)",
					"var.untethered": "round(balloon_signal3.ry)"
				},
				{
					"cannonbase.ry": "var.cy*var.yaw_sign",
					"cannonbarrel.rx": "var.cp*var.pitch_sign",
					"crossbow.rx": "var.xp*var.pitch_sign",
					"opendoors.visible": "var.drop >= 1",
					"closedoors.visible": "var.drop == 0",
					"hangingchain1.visible": "var.untethered == 1",
					"hangingchain2.visible": "var.untethered == 1",
					"hangingchain3.visible": "var.untethered == 1",
					"hangingchain4.visible": "var.untethered == 1",
					"loonrudder.ry": "clamp(var.lag*var.rudder_gain, torad(-10), torad(10))*var.rudder_dir",
					"rudder.rz": "torad(5)*sin(var.id +age*pi/60)"
				},
				{
					"var.pre_roty": "rot_y",
					"var.pre_Oroty": "var.roty",
					"var.pre_frame_counter": "frame_counter"
				},
				{
					"prop.rz": "time * 0.15"
				},
				{
					"ecoutrements.rx": "( -sin(var.Bt/6)/8*var.moveB )*var.sway +torad( (-9-20*sin(limb_swing/4))*var.hurt )*var.flinch",
					"ecoutrements.rz": "( sin(var.Bt/5)/20*var.moveB )*var.sway +clamp( var.lag/2, -1, 1 )/3*min(1,var.speed*4)*var.lean +torad( 30*cos(limb_swing/6)*var.hurt )*var.flinch"
				}
			]
		},

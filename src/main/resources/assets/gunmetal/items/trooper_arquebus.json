{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": [
          "trooper_idle",
          "trooper_reloading"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "gunmetal:item/trooper_arquebus_rest"
        }
      },
      {
        "when": [
          "trooper_aiming",
          "trooper_bayonet_fixed"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "gunmetal:item/trooper_arquebus_aim"
        }
      },
      {
        "when": [
          "trooper_smoke_chambered"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "gunmetal:item/trooper_arquebus_smoke"
        }
      },
      {
        "when": [
          "trooper_charging",
          "trooper_fixing"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "gunmetal:item/trooper_arquebus_charge"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "gunmetal:loaded",
      "on_true": {
        "type": "minecraft:model",
        "model": "gunmetal:item/trooper_arquebus_loaded"
      },
      "on_false": {
        "type": "minecraft:condition",
        "property": "minecraft:has_component",
        "component": "gunmetal:loading_stage",
        "on_true": {
          "type": "minecraft:model",
          "model": "gunmetal:item/trooper_arquebus_loading"
        },
        "on_false": {
          "type": "minecraft:model",
          "model": "gunmetal:item/trooper_arquebus"
        }
      }
    }
  }
}

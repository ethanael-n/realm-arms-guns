{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": [
          "sharpshooter_idle"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "gunmetal:item/sharpshooter_rifle_rest"
        }
      },
      {
        "when": [
          "sharpshooter_target_acquired",
          "sharpshooter_shot_locked"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "gunmetal:item/sharpshooter_rifle_aim"
        }
      },
      {
        "when": [
          "sharpshooter_reloading"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "gunmetal:item/sharpshooter_rifle_reload"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "gunmetal:loaded",
      "on_true": {
        "type": "minecraft:model",
        "model": "gunmetal:item/sharpshooter_rifle_loaded"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "gunmetal:item/sharpshooter_rifle"
      }
    }
  }
}
